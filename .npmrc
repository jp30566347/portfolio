# pnpm's default isolated layout keeps transitive deps out of the top-level
# node_modules, which breaks tailwind.config.ts's content glob:
#   ./node_modules/@nextui-org/theme/dist/**
# Without it, NextUI's utility classes (e.g. h-[var(--navbar-height)]) are never
# generated and the navbar collapses from 72px to 52px.
# Removed once NextUI is dropped.
public-hoist-pattern[]=@nextui-org/*
